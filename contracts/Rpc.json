{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://statly.local/contracts/Rpc.json",
  "title": "Rpc",
  "description": "Params/result schemas for the Phase 1 JSON-RPC methods (method table in contracts/README.md). Definitions only; the root schema itself is not used.",
  "$defs": {
    "CellValue": {
      "title": "CellValue",
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "ImportFileInput": {
      "title": "ImportFileInput",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sheet_name"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Absolute path chosen via the OS file dialog."
        },
        "sheet_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "XLSX sheet; null = first sheet / ask."
        }
      }
    },
    "DatasetImportPreviewParams": {
      "title": "DatasetImportPreviewParams",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "qualtrics_mode",
        "stack_onto_dataset_id"
      ],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ImportFileInput"
          }
        },
        "qualtrics_mode": {
          "title": "QualtricsMode",
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ]
        },
        "stack_onto_dataset_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Set when previewing files to append to an existing dataset (dataset.stack)."
        }
      }
    },
    "ImportIssue": {
      "title": "ImportIssue",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message",
        "file_id",
        "column"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "$ref": "AnalysisResult.json#/$defs/ResultWarning/properties/severity"
        },
        "message": {
          "type": "string"
        },
        "file_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "column": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "CompanionPair": {
      "title": "CompanionPair",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values_file_id",
        "labels_file_id",
        "columns_matched"
      ],
      "description": "Two files holding the same responses exported twice: once with numeric codes (values) and once with answer text (labels).",
      "properties": {
        "values_file_id": {
          "type": "string",
          "description": "File whose numeric codes become the data."
        },
        "labels_file_id": {
          "type": "string",
          "description": "File whose answer text becomes value labels; contributes no rows."
        },
        "columns_matched": {
          "type": "integer",
          "minimum": 0,
          "description": "Columns that are numbers in one file and text in the other."
        }
      }
    },
    "CompanionChoice": {
      "title": "CompanionChoice",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values_file_id",
        "labels_file_id"
      ],
      "description": "Import values_file_id as the dataset and take value labels from labels_file_id (must match the preview's companion_pair).",
      "properties": {
        "values_file_id": {
          "type": "string"
        },
        "labels_file_id": {
          "type": "string"
        }
      }
    },
    "FilePreview": {
      "title": "FilePreview",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_id",
        "path",
        "name",
        "sha256",
        "size_bytes",
        "format",
        "sheets",
        "sheet_name",
        "encoding",
        "delimiter",
        "qualtrics",
        "n_rows",
        "proposed_variables",
        "sample_rows",
        "suggested_row_filters",
        "suggested_scales",
        "multiselect_candidates",
        "issues"
      ],
      "properties": {
        "file_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "format": {
          "$ref": "DatasetMeta.json#/$defs/FileFormat"
        },
        "sheets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sheet_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "encoding": {
          "type": [
            "string",
            "null"
          ]
        },
        "delimiter": {
          "type": [
            "string",
            "null"
          ]
        },
        "qualtrics": {
          "$ref": "DatasetMeta.json#/$defs/QualtricsDetection"
        },
        "n_rows": {
          "type": "integer",
          "minimum": 0
        },
        "proposed_variables": {
          "type": "array",
          "items": {
            "$ref": "VariableSchema.json"
          },
          "description": "Engine's best guess per column (role, level, labels, metadata/PII flags) for user confirmation."
        },
        "sample_rows": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/CellValue"
            }
          },
          "description": "First rows, cells in proposed_variables order."
        },
        "suggested_row_filters": {
          "type": "array",
          "items": {
            "$ref": "DatasetMeta.json#/$defs/RowFilter"
          },
          "description": "rows_removed = rows that WOULD be removed."
        },
        "suggested_scales": {
          "type": "array",
          "items": {
            "$ref": "DatasetMeta.json#/$defs/Scale"
          },
          "description": "Matrix-question groupings (origin matrix_suggestion)."
        },
        "multiselect_candidates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Columns holding comma-separated multi-select answers (split offered in Phase 2)."
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ImportIssue"
          }
        }
      }
    },
    "ColumnRef": {
      "title": "ColumnRef",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_id",
        "column"
      ],
      "properties": {
        "file_id": {
          "type": "string"
        },
        "column": {
          "type": "string"
        }
      }
    },
    "ColumnMatch": {
      "title": "ColumnMatch",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variable",
        "status",
        "similarity",
        "columns"
      ],
      "properties": {
        "variable": {
          "type": "string",
          "description": "Resulting variable name in the stacked dataset."
        },
        "status": {
          "title": "ColumnMatchStatus",
          "type": "string",
          "enum": [
            "matched",
            "unmatched",
            "possibly_renamed"
          ]
        },
        "similarity": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "Fuzzy question-text similarity for possibly_renamed."
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ColumnRef"
          },
          "description": "One column per file that contributes; files missing here get NA."
        }
      }
    },
    "DatasetImportPreviewResult": {
      "title": "DatasetImportPreviewResult",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preview_id",
        "files",
        "stack_proposal"
      ],
      "properties": {
        "preview_id": {
          "type": "string",
          "description": "Handle to the engine's staged parse; valid until the next import_preview or engine restart."
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FilePreview"
          }
        },
        "stack_proposal": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ColumnMatch"
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Column matching across files (or against stack_onto_dataset_id); null for a single new file."
        },
        "companion_pair": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompanionPair"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional. Set when exactly two new files are the same responses exported as numbers and as text; the UI should import them as one dataset (DatasetImportParams.companion) rather than stack them."
        }
      }
    },
    "ImportFileDecision": {
      "title": "ImportFileDecision",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_id",
        "sheet_name",
        "encoding",
        "delimiter",
        "qualtrics_header_rows",
        "time_label",
        "drop_columns"
      ],
      "properties": {
        "file_id": {
          "type": "string"
        },
        "sheet_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "encoding": {
          "type": [
            "string",
            "null"
          ]
        },
        "delimiter": {
          "type": [
            "string",
            "null"
          ]
        },
        "qualtrics_header_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "time_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "drop_columns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Columns dropped at import (e.g. PII); recorded in import_log.dropped_columns."
        }
      }
    },
    "StackConfig": {
      "title": "StackConfig",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_variable",
        "levels",
        "column_matches"
      ],
      "properties": {
        "time_variable": {
          "type": "string"
        },
        "levels": {
          "type": "array",
          "items": {
            "$ref": "DatasetMeta.json#/$defs/StackLevel"
          }
        },
        "column_matches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ColumnMatch"
          },
          "description": "User-confirmed matching."
        }
      }
    },
    "DatasetImportParams": {
      "title": "DatasetImportParams",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preview_id",
        "files",
        "row_filters",
        "variables",
        "stack"
      ],
      "properties": {
        "preview_id": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ImportFileDecision"
          }
        },
        "row_filters": {
          "type": "array",
          "items": {
            "$ref": "DatasetMeta.json#/$defs/RowFilter"
          },
          "description": "Filters to apply; rows_removed on input is ignored and recomputed."
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "VariableSchema.json"
          },
          "description": "User-confirmed variable metadata (from proposed_variables); empty = accept proposals."
        },
        "stack": {
          "anyOf": [
            {
              "$ref": "#/$defs/StackConfig"
            },
            {
              "type": "null"
            }
          ],
          "description": "Required when importing 2+ files at once."
        },
        "companion": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompanionChoice"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional. Import a companion pair as one dataset: `files` holds the values file's decision (a decision for the labels file is ignored) and `stack` must be null."
        },
        "survey": {
          "anyOf": [
            {
              "$ref": "#/$defs/SurveyChoice"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional. A Qualtrics survey file (.qsf) stored with the dataset as an original (ImportedFile.role 'survey'). Metadata suggestions come from survey.suggest."
        }
      }
    },
    "DatasetResult": {
      "title": "DatasetResult",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_meta"
      ],
      "properties": {
        "dataset_meta": {
          "$ref": "DatasetMeta.json"
        }
      }
    },
    "DatasetStackParams": {
      "title": "DatasetStackParams",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "preview_id",
        "files",
        "row_filters",
        "variables",
        "stack"
      ],
      "properties": {
        "dataset_id": {
          "type": "string"
        },
        "preview_id": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ImportFileDecision"
          }
        },
        "row_filters": {
          "type": "array",
          "items": {
            "$ref": "DatasetMeta.json#/$defs/RowFilter"
          },
          "description": "Filters to apply; rows_removed on input is ignored and recomputed."
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "VariableSchema.json"
          },
          "description": "User-confirmed variable metadata (from proposed_variables); empty = accept proposals."
        },
        "stack": {
          "$ref": "#/$defs/StackConfig"
        }
      },
      "description": "Append newly previewed files (e.g. a later Follow-up export) to an existing dataset."
    },
    "DatasetLinkParams": {
      "title": "DatasetLinkParams",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "mode",
        "id_variable",
        "normalization"
      ],
      "properties": {
        "dataset_id": {
          "type": "string"
        },
        "mode": {
          "$ref": "DatasetMeta.json#/$defs/LinkConfig/properties/mode"
        },
        "id_variable": {
          "type": [
            "string",
            "null"
          ]
        },
        "normalization": {
          "anyOf": [
            {
              "$ref": "DatasetMeta.json#/$defs/IdNormalization"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "LinkReport": {
      "title": "LinkReport",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counts",
        "unmatched_ids",
        "duplicate_ids",
        "explanation"
      ],
      "properties": {
        "counts": {
          "$ref": "DatasetMeta.json#/$defs/LinkCounts"
        },
        "unmatched_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "description": "Normalized IDs (sample, max 200)."
        },
        "duplicate_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 200
        },
        "explanation": {
          "type": "string"
        }
      }
    },
    "DatasetLinkResult": {
      "title": "DatasetLinkResult",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_meta",
        "report"
      ],
      "properties": {
        "dataset_meta": {
          "$ref": "DatasetMeta.json"
        },
        "report": {
          "anyOf": [
            {
              "$ref": "#/$defs/LinkReport"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "RowSort": {
      "title": "RowSort",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variable",
        "descending"
      ],
      "properties": {
        "variable": {
          "type": "string"
        },
        "descending": {
          "type": "boolean"
        }
      }
    },
    "DatasetRowsParams": {
      "title": "DatasetRowsParams",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "snapshot_id",
        "offset",
        "limit",
        "columns",
        "sort"
      ],
      "properties": {
        "dataset_id": {
          "type": "string"
        },
        "snapshot_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "If set and stale, the engine returns error -32002."
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "columns": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "null = all variables in display order."
        },
        "sort": {
          "anyOf": [
            {
              "$ref": "#/$defs/RowSort"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "DatasetRowsResult": {
      "title": "DatasetRowsResult",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "offset",
        "total_rows",
        "columns",
        "row_ids",
        "rows"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "total_rows": {
          "type": "integer",
          "minimum": 0
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "row_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "_statly_row_id per returned row."
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/CellValue"
            }
          },
          "description": "Row-major; missing-coded values are returned as stored (not nulled)."
        }
      }
    },
    "DatasetIdParams": {
      "title": "DatasetIdParams",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id"
      ],
      "properties": {
        "dataset_id": {
          "type": "string"
        }
      }
    },
    "DatasetMissingSummaryResult": {
      "title": "DatasetMissingSummaryResult",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "missing_summary"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string"
        },
        "missing_summary": {
          "type": "array",
          "items": {
            "$ref": "DatasetMeta.json#/$defs/VariableMissingSummary"
          }
        }
      }
    },
    "ProjectSaveParams": {
      "title": "ProjectSaveParams",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "project"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Destination .statly path. Written atomically (temp file + rename); deletes this project's autosave on success."
        },
        "project": {
          "$ref": "ProjectFile.json"
        }
      },
      "description": " Frontend-held parts; the engine substitutes its authoritative dataset_meta and data."
    },
    "ProjectSaveResult": {
      "title": "ProjectSaveResult",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "saved_at",
        "size_bytes",
        "project"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "saved_at": {
          "type": "string",
          "format": "date-time"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "project": {
          "$ref": "ProjectFile.json"
        }
      }
    },
    "ProjectLoadParams": {
      "title": "ProjectLoadParams",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        }
      }
    },
    "ProjectLoadResult": {
      "title": "ProjectLoadResult",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "is_autosave",
        "autosave_marker"
      ],
      "properties": {
        "project": {
          "$ref": "ProjectFile.json"
        },
        "is_autosave": {
          "type": "boolean"
        },
        "autosave_marker": {
          "anyOf": [
            {
              "$ref": "ProjectFile.json#/$defs/AutosaveMarker"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ProjectAutosaveParams": {
      "title": "ProjectAutosaveParams",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "autosave_dir",
        "original_path",
        "project"
      ],
      "properties": {
        "autosave_dir": {
          "type": "string",
          "description": "App data dir supplied by the shell (Tauri appDataDir/autosave)."
        },
        "original_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "$ref": "ProjectFile.json"
        }
      }
    },
    "ProjectAutosaveResult": {
      "title": "ProjectAutosaveResult",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "autosave_path",
        "saved_at"
      ],
      "properties": {
        "autosave_path": {
          "type": "string"
        },
        "saved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ProjectRecoverableParams": {
      "title": "ProjectRecoverableParams",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "autosave_dir"
      ],
      "properties": {
        "autosave_dir": {
          "type": "string"
        }
      }
    },
    "RecoverableAutosave": {
      "title": "RecoverableAutosave",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "autosave_path",
        "marker"
      ],
      "properties": {
        "autosave_path": {
          "type": "string"
        },
        "marker": {
          "$ref": "ProjectFile.json#/$defs/AutosaveMarker"
        }
      }
    },
    "ProjectRecoverableResult": {
      "title": "ProjectRecoverableResult",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "autosaves"
      ],
      "properties": {
        "autosaves": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecoverableAutosave"
          }
        }
      }
    },
    "ProjectDiscardAutosaveParams": {
      "title": "ProjectDiscardAutosaveParams",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "autosave_path"
      ],
      "properties": {
        "autosave_path": {
          "type": "string"
        }
      }
    },
    "OkResult": {
      "title": "OkResult",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok"
      ],
      "properties": {
        "ok": {
          "const": true
        }
      }
    },
    "SurveyChoice": {
      "title": "SurveyChoice",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_path"
      ],
      "description": "A Qualtrics survey design file (.qsf) to keep with the import. Its untouched original is stored in the project like a data file (ImportedFile.role 'survey'); it contributes no rows or variables.",
      "properties": {
        "file_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SurveyColumn": {
      "title": "SurveyColumn",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "label",
        "value_labels",
        "level",
        "group"
      ],
      "description": "One column a data export of the survey would contain.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Export column name, e.g. Q5_1."
        },
        "label": {
          "type": "string",
          "description": "Short label: the matrix statement, choice text, or question text."
        },
        "value_labels": {
          "type": "array",
          "items": {
            "$ref": "VariableSchema.json#/$defs/ValueLabel"
          },
          "description": "Answer choices in display order (codes = Qualtrics recode values)."
        },
        "level": {
          "type": "string",
          "enum": [
            "nominal",
            "ordinal",
            "scale",
            "text"
          ]
        },
        "group": {
          "type": [
            "string",
            "null"
          ],
          "description": "Matrix question tag for matrix statements."
        },
        "correct_values": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "string"
            ]
          },
          "description": "Scored single-answer question: codes of the choice(s) the survey's scoring gives points (the correct answer). Empty/absent when the survey has no scoring for it."
        }
      }
    },
    "SurveyQuestion": {
      "title": "SurveyQuestion",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "qid",
        "text",
        "kind",
        "question_type",
        "selector",
        "required",
        "columns",
        "notes",
        "in_trash"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "description": "Export tag, e.g. Q5."
        },
        "qid": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "description": "Question wording, HTML stripped."
        },
        "kind": {
          "type": "string",
          "enum": [
            "single",
            "multi",
            "matrix",
            "text",
            "slider",
            "other"
          ]
        },
        "question_type": {
          "type": "string"
        },
        "selector": {
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SurveyColumn"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "in_trash": {
          "type": "boolean",
          "description": "Deleted in the survey editor: listed, never part of a data export."
        }
      }
    },
    "Survey": {
      "title": "Survey",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "questions",
        "notes"
      ],
      "description": "A parsed Qualtrics survey design (.qsf).",
      "properties": {
        "name": {
          "type": "string"
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SurveyQuestion"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "SurveyParseParams": {
      "title": "SurveyParseParams",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_path"
      ],
      "properties": {
        "file_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SurveyParseResult": {
      "title": "SurveyParseResult",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "survey",
        "issues"
      ],
      "properties": {
        "survey": {
          "$ref": "#/$defs/Survey"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ImportIssue"
          }
        }
      }
    },
    "SurveyVariableRef": {
      "title": "SurveyVariableRef",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name"
      ],
      "description": "A variable to match against the survey: at least its name; current label/question_text/value_labels/level/dtype/is_metadata/computed when known (a VariableSchema qualifies).",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SurveySuggestParams": {
      "title": "SurveySuggestParams",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "description": "Match a survey to variables. Variables: `variables` when given (e.g. an import preview's proposals), else the dataset's (dataset_id). Survey: `survey` when given, else the survey file stored with the dataset at import.",
      "properties": {
        "dataset_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "snapshot_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "survey": {
          "anyOf": [
            {
              "$ref": "#/$defs/Survey"
            },
            {
              "type": "null"
            }
          ]
        },
        "variables": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SurveyVariableRef"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "SurveyColumnSuggestion": {
      "title": "SurveyColumnSuggestion",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "survey_column",
        "question_tag",
        "label",
        "question_text",
        "value_labels",
        "level",
        "notes",
        "differs_from_current"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Dataset variable name."
        },
        "survey_column": {
          "type": "string"
        },
        "question_tag": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "question_text": {
          "type": "string"
        },
        "value_labels": {
          "type": "array",
          "items": {
            "$ref": "VariableSchema.json#/$defs/ValueLabel"
          }
        },
        "level": {
          "$ref": "VariableSchema.json#/$defs/MeasurementLevel"
        },
        "question_kind": {
          "type": "string",
          "enum": [
            "single",
            "multi",
            "matrix",
            "text",
            "slider",
            "other"
          ],
          "description": "Optional; the survey question's kind (single = single-answer multiple choice)."
        },
        "role": {
          "type": "string",
          "enum": [
            "open_text",
            "likert_item"
          ],
          "description": "Optional role hint."
        },
        "reverse_hint": {
          "type": "boolean",
          "description": "Optional; true when the statement is explicitly marked reverse-worded."
        },
        "correct_values": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "string"
            ]
          },
          "description": "Scored single-answer question: codes of the choice(s) the survey's scoring gives points (the correct answer). Empty/absent when the survey has no scoring for it."
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "differs_from_current": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "label",
              "question_text",
              "value_labels",
              "level"
            ]
          },
          "description": "Fields where the variable already has a different non-empty value (never overwrite these silently)."
        }
      }
    },
    "SurveyScaleSuggestion": {
      "title": "SurveyScaleSuggestion",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "label",
        "items",
        "origin",
        "reverse_hint_items"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Matrix question tag."
        },
        "label": {
          "type": "string",
          "description": "Matrix stem text."
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "origin": {
          "type": "string",
          "enum": [
            "matrix_suggestion"
          ]
        },
        "reverse_hint_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "SurveySuggestResult": {
      "title": "SurveySuggestResult",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "survey_name",
        "columns",
        "scales",
        "unmatched"
      ],
      "properties": {
        "survey_name": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SurveyColumnSuggestion"
          }
        },
        "scales": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SurveyScaleSuggestion"
          }
        },
        "unmatched": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "survey_columns",
            "dataset_columns"
          ],
          "properties": {
            "survey_columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "dataset_columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
