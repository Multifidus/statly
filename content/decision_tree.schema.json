{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://statly.local/content/decision_tree.schema.json",
  "title": "DecisionTree",
  "description": "Test Advisor decision tree (SPEC §7.1). Single source of truth for test selection; the engine evaluator (engine/statly_engine/advisor) is a pure function over this data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "root", "nodes"],
  "properties": {
    "version": { "const": 1 },
    "root": {
      "type": "string",
      "description": "Node id to start evaluation from."
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/Node" }
    }
  },
  "$defs": {
    "Node": {
      "oneOf": [
        { "$ref": "#/$defs/QuestionNode" },
        { "$ref": "#/$defs/RecommendationNode" }
      ]
    },
    "DatasetContextField": {
      "type": "string",
      "enum": ["outcome_level", "num_groups", "num_time_points", "linked_mode", "covariates_present", "n_complete", "outcome_distinct", "second_distinct"]
    },
    "AutoRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "value"],
      "properties": {
        "when": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "equals": {},
            "min": { "type": "number" },
            "max": { "type": "number" },
            "in": { "type": "array", "minItems": 1 }
          }
        },
        "value": { "type": ["string", "number", "boolean"] }
      }
    },
    "AutoSingle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "rules"],
      "properties": {
        "field": { "$ref": "#/$defs/DatasetContextField" },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/AutoRule" }
        }
      }
    },
    "Auto": {
      "oneOf": [
        { "$ref": "#/$defs/AutoSingle" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any", "otherwise"],
          "description": "OR across several fields: first sub-block whose field is known in dataset_context and whose rules match wins; `otherwise` is used once any field is known but none matched.",
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/AutoSingle" }
            },
            "otherwise": { "type": ["string", "number", "boolean"] }
          }
        }
      ]
    },
    "Option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label", "next"],
      "properties": {
        "value": { "type": ["string", "number", "boolean"] },
        "label": { "type": "string", "minLength": 1 },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "One plain-language sentence with a concrete example, shown inline under the option's label."
        },
        "next": { "type": "string" }
      }
    },
    "QuestionNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text", "why", "options"],
      "properties": {
        "type": { "const": "question" },
        "text": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "hint": {
          "type": "string",
          "minLength": 1,
          "description": "One or two plain-language sentences (grade 8-10) shown inline under the question text, defining any term in the question with an example."
        },
        "auto": { "$ref": "#/$defs/Auto" },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/Option" }
        }
      }
    },
    "RecommendationNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "primary_test",
        "nonparametric_alternative",
        "assumptions",
        "effect_size",
        "post_hoc",
        "why_this_test",
        "likert_note",
        "caveats"
      ],
      "properties": {
        "type": { "const": "recommendation" },
        "primary_test": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
        "nonparametric_alternative": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
            { "type": "null" }
          ]
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "effect_size": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "post_hoc": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" }
        },
        "why_this_test": { "type": "string", "minLength": 1 },
        "likert_note": { "type": ["string", "null"] },
        "caveats": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        }
      }
    }
  }
}
